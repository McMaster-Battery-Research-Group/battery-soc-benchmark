generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Optional: for Supabase/pgBouncer set DATABASE_URL to the pooled (6543) URL
  // and DIRECT_URL to the direct (5432) URL used for `prisma db push`/migrate.
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum ModelType {
  COULOMB_COUNTER
  EKF
  UKF
  LSTM
  GRU
  FNN
  TRANSFORMER
  PHYSICS
  HYBRID
  OTHER
}

enum EvaluationLevel {
  DYNAMIC
  STATIC
}

enum FileType {
  ZIP
  MAT
  PY
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ContestStatus {
  DRAFT
  OPEN
  CLOSED
  JUDGED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  affiliation   String
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Public researcher profile (all optional)
  occupation      String?
  bio             String?
  website         String?
  linkedin        String?
  orcid           String?
  googleScholar   String?
  researchGate    String?
  github          String?
  avatar          Bytes?    // small JPEG (≤256 px), resized in the browser before upload
  avatarType      String?
  avatarUpdatedAt DateTime?

  submissions    Submission[]
  contestEntries ContestEntry[]
  tokens         UserToken[]
  messages       ContactMessage[]
  dryRuns        DryRun[]
  collaborations SubmissionCollaborator[]
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model UserToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Submission {
  id              String           @id @default(cuid())
  seq             Int              @unique @default(autoincrement())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelName       String
  description     String
  modelType       ModelType
  evaluationLevel EvaluationLevel  @default(DYNAMIC)
  isPrivate       Boolean          @default(false)
  isHidden        Boolean          @default(false)
  fileKey         String
  fileName        String
  fileType        FileType
  fileSize        Int
  status          SubmissionStatus @default(QUEUED)
  failureMessage  String?
  submittedAt     DateTime         @default(now())
  completedAt     DateTime?
  contestId       String?
  contest         Contest?         @relation(fields: [contestId], references: [id], onDelete: SetNull)

  result        EvaluationResult?
  job           EvaluationJob?
  collaborators SubmissionCollaborator[]
  revisions     ScoreRevision[]

  @@index([userId])
  @@index([contestId])
  @@index([status])
}

/// Append-only score history: one row per evaluation attempt, failure,
/// re-evaluation or re-score. EvaluationResult holds the current numbers.
model ScoreRevision {
  id               String     @id @default(cuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())
  kind             String // evaluation | failure | rescore | reevaluation
  evaluatorVersion String
  weightedError    Float?
  complexity       Int?
  maxError         Float?
  metrics          Json? // the 18 per-test values at that time
  note             String? // reason / failure message
  by               String? // worker id, script, or admin user id

  @@index([submissionId, createdAt])
}

/// Co-authors on a submission (must have an account). They can view it even when
/// private and appear beside the owner on the leaderboard; only the owner edits.
model SubmissionCollaborator {
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())
  /// Set once the owner confirmed and the "you were added" e-mail went out.
  /// Unconfirmed collaborators are listed but receive no e-mails.
  notifiedAt   DateTime?
  /// Set when the collaborator accepted the invitation. Only accepted
  /// collaborators are shown publicly (leaderboard, researcher pages).
  acceptedAt   DateTime?
  /// One-time token for the Accept / Decline links in the invitation e-mail.
  inviteToken  String?    @unique

  @@id([submissionId, userId])
  @@index([userId])
}

/// One row per completed evaluation. Test-case fields map to Table IV of
/// Kollmeyer et al., ITEC 2022. All errors are average RMSE in % SOC.
model EvaluationResult {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  weightedError         Float
  complexity            Int
  complexityUncertainty Int   @default(1)

  // Test cases 1–3
  allCells        Float
  blindedCell     Float
  nonBlindedCells Float
  // 4
  charging Float
  // 5/6 — range of loads (payload + HVAC)
  massM80   Float
  massM448  Float
  massM448N Float
  massM1000 Float
  // 7–8 — drive cycle type
  standardCycles    Float
  nonStandardCycles Float
  // 9 — temperature
  tempM20 Float
  tempM10 Float
  temp0   Float
  temp10  Float
  temp25  Float
  temp40  Float
  // 10–11 — robustness
  initialSocError     Float
  currentSensorOffset Float

  maxError Float

  /// Array of { cell, cycle, temperatureC, rmse, mae, maxErr, durationH }
  perCycle Json
  /// Array of { key, label, cell, cycle, temperatureC, t: number[], actual: number[], estimated: number[] }
  timeSeries Json

  evaluatorVersion String   @default("mock-1")
  createdAt        DateTime @default(now())
}

/// Sliding-window rate limiting for sensitive actions (login, register, reset,
/// contact, uploads). One row per hit; counted per key within a window and
/// pruned opportunistically. Works across Vercel's stateless functions.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Liveness of evaluation workers (one row per worker process). The site uses
/// it to tell users whether evaluations are currently running or waiting.
model WorkerHeartbeat {
  id          String   @id // hostname-pid
  hostname    String
  evaluator   String
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// ids of submissions / dry runs currently being evaluated (parallel slots)
  busyWith    String[] @default([])
  concurrency Int      @default(1)
  /// admin command picked up at the next heartbeat: "pause" | "resume" | "stop"
  command     String?
  paused      Boolean  @default(false)
  // diagnostics (refreshed every heartbeat)
  platform    String   @default("")
  nodeVersion String   @default("")
  cpus        Int      @default(0)
  loadAvg     Float    @default(0)
  memTotalMb  Int      @default(0)
  memFreeMb   Int      @default(0)
  diskFreeMb  Int?
  pythonInfo  String   @default("") // e.g. "Python 3.12.4 · numpy 2.1 · scipy 1.14 · torch 2.4"
  matlabInfo  String   @default("") // e.g. "R2026a at C:\Program Files\MATLAB\R2026a" or "not configured"
  blindData   Boolean  @default(false) // SOCBENCH_BLIND_DATA present and readable
  gitSha      String   @default("")
  completed   Int      @default(0)
  failed      Int      @default(0)
  lastError   String?
  /// last ~200 console lines of this worker (ring buffer) for the admin panel
  log         String   @default("")
}

model EvaluationJob {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attempts     Int        @default(0)
  lockedAt     DateTime?
  lockedBy     String?
  log          String     @default("")
  /// Set when the owner asks to cancel a running evaluation; the worker aborts
  /// the evaluator process and deletes the submission.
  cancelRequestedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([lockedAt])
}

model Contest {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  title                 String
  summary               String
  description           String
  rules                 String
  prizeText             String
  startsAt              DateTime
  endsAt                DateTime
  status                ContestStatus @default(DRAFT)
  maxSubmissionsPerUser Int           @default(5)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  entries     ContestEntry[]
  submissions Submission[]
}

model ContestEntry {
  id             String   @id @default(cuid())
  contestId      String
  contest        Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedTerms  DateTime @default(now())
  teamName       String?

  @@unique([contestId, userId])
}

/// Pre-submission check on OPEN data (no scores, no leaderboard). Replaces the
/// old downloadable "Model Submission Test Tool"; works for Python and MATLAB packages.
model DryRun {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileKey        String
  fileName       String
  fileSize       Int
  status         SubmissionStatus @default(QUEUED)
  result         Json?
  failureMessage String?
  log            String           @default("")
  lockedAt       DateTime?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, lockedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  category  String   @default("question") // question | bug | feature | contest | data | other
  subject   String
  body      String
  pageUrl   String?  // where the user was when they wrote it
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}
