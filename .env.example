# Copy to .env and adjust.

# PostgreSQL (docker compose up -d). For Supabase: DATABASE_URL = the
# "Transaction" pooler URL (port 6543) + "?pgbouncer=true", DIRECT_URL = the
# direct URL (port 5432). Locally both can be the same.
DATABASE_URL="postgresql://socbench:socbench@localhost:5433/socbench?schema=public"
DIRECT_URL="postgresql://socbench:socbench@localhost:5433/socbench?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Public site URL used in emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP. Leave SMTP_HOST blank in development to use an auto-created Ethereal
# test inbox (preview URLs are printed to the console).
#
# Free production option — Brevo (300 emails/day, no domain DNS needed):
#   1. https://app.brevo.com → sign up → Senders & IP → add + verify the address
#      you will send from (e.g. your @mcmaster.ca address).
#   2. SMTP & API → SMTP → "Generate a new SMTP key".
#   3. Fill in below. SMTP_USER is your Brevo login email; SMTP_PASS is the SMTP
#      key (NOT your Brevo password); MAIL_FROM must be the verified sender.
# Temporary option — personal Gmail (~500/day, From is forced to your address):
#   Google Account → Security → 2-Step Verification ON → App passwords → create one
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password>  MAIL_FROM="Battery SOC Benchmark <you@gmail.com>"
#
SMTP_HOST=""              # smtp.gmail.com | smtp-relay.brevo.com | smtp.resend.com
SMTP_PORT="587"
SMTP_USER=""              # your Brevo login email
SMTP_PASS=""              # Brevo SMTP key
MAIL_FROM="Battery SOC Benchmark <you@mcmaster.ca>"   # must match a verified Brevo sender

# Package storage: "local" (disk, dev / single server) or "blob" (Vercel Blob —
# required when the web app runs on Vercel and the worker elsewhere).
STORAGE="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="50"
# From the Vercel Blob store (Storage → Create → Blob). Needed by BOTH the web app and the worker.
BLOB_READ_WRITE_TOKEN=""

# Shared secret for the on-demand queue endpoint /api/jobs/run (external cron).
# Leave empty to disable the endpoint. Generate with: openssl rand -hex 24
CRON_SECRET=""

# Evaluator: "mock" (built-in, deterministic) or "matlab" (lab script, not yet wired)
EVALUATOR="mock"
# Seconds the mock evaluator "runs" so the UI status flow can be observed
MOCK_EVAL_SECONDS="8"

# Seed admin account
SEED_ADMIN_EMAIL="admin@batterysocbenchmark.ca"
SEED_ADMIN_PASSWORD="Admin123!"
