# Copy to .env and adjust.

# PostgreSQL (docker compose up -d). For Supabase: DATABASE_URL = the
# "Transaction" pooler URL (port 6543) + "?pgbouncer=true", DIRECT_URL = the
# direct URL (port 5432). Locally both can be the same.
DATABASE_URL="postgresql://socbench:socbench@localhost:5433/socbench?schema=public"
DIRECT_URL="postgresql://socbench:socbench@localhost:5433/socbench?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Public site URL used in emails
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP. Leave SMTP_HOST blank in development to use an auto-created Ethereal
# test inbox (preview URLs are printed to the console).
#
# Free production option — Brevo (300 emails/day, no domain DNS needed):
#   1. https://app.brevo.com → sign up → Senders & IP → add + verify the address
#      you will send from (e.g. your @mcmaster.ca address).
#   2. SMTP & API → SMTP → "Generate a new SMTP key".
#   3. Fill in below. SMTP_USER is your Brevo login email; SMTP_PASS is the SMTP
#      key (NOT your Brevo password); MAIL_FROM must be the verified sender.
# Temporary option — personal Gmail (~500/day, From is forced to your address):
#   Google Account → Security → 2-Step Verification ON → App passwords → create one
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password>  # Where feedback/contact notifications go (comma-separated). Default: every ADMIN account.
ADMIN_NOTIFY_EMAIL=""
MAIL_FROM="Battery SOC Benchmark <you@gmail.com>"
#
SMTP_HOST=""              # smtp.gmail.com | smtp-relay.brevo.com | smtp.resend.com
SMTP_PORT="587"
SMTP_USER=""              # your Brevo login email
SMTP_PASS=""              # Brevo SMTP key
# Where feedback/contact notifications go (comma-separated). Default: every ADMIN account.
ADMIN_NOTIFY_EMAIL=""
MAIL_FROM="Battery SOC Benchmark <you@mcmaster.ca>"   # must match a verified Brevo sender

# Administrator accounts (comma-separated emails). Promoted automatically on
# registration / sign-in, exempt from the dry-run rate limit, shown with an
# Admin badge. Admins can also be granted/revoked at /admin/users.
ADMIN_EMAILS="kollmeyp@mcmaster.ca,ahmad100307@gmail.com"

# Package storage: "local" (disk, dev / single server) or "blob" (Vercel Blob —
# required when the web app runs on Vercel and the worker elsewhere).
STORAGE="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="50"
# From the Vercel Blob store (Storage → Create → Blob). Needed by BOTH the web app and the worker.
BLOB_READ_WRITE_TOKEN=""

# Shared secret for the on-demand queue endpoint /api/jobs/run (external cron).
# Leave empty to disable the endpoint. Generate with: openssl rand -hex 24
CRON_SECRET=""

# Evaluator on the worker host:
#   mock   built-in deterministic numbers (dev / demo)
#   real   socbench_eval — Python runs Model.py in-process; Model.m/.p is executed
#          by MATLAB via matlab/Run_Model.m (MATLAB needed only for those packages)
EVALUATOR="mock"
# --- real evaluator (worker host only; the blinded data must never be on the web tier) ---
SOCBENCH_BLIND_DATA=""    # blind-data/blind_data.mat (from matlab/Export_Blind_Data.m)
SOCBENCH_PYTHON="python"  # python with numpy and scipy (pip install -r evaluator/python/requirements.txt)
MATLAB_BIN="matlab"       # matlab executable, only needed for Model.m/.p submissions
SOCBENCH_CAL_PYTHON="9.2e-7"  # complexity calibration (s/sample ÷ 10^(1/3)) so a plain Coulomb counter lands in bin 2; measured on Ahmad's laptop
SOCBENCH_CAL_MATLAB="3.5e-8"
# Seconds the mock evaluator "runs" so the UI status flow can be observed
MOCK_EVAL_SECONDS="8"
# Worker only: evaluations run in parallel on ONE machine (CPU-bound; keep ≤ physical cores / 2).
# To scale across machines just run `npm run worker` on more of them — no other config.
WORKER_CONCURRENCY="1"

# Seed admin account
SEED_ADMIN_EMAIL="admin@batterysocbenchmark.ca"
SEED_ADMIN_PASSWORD="Admin123!"
